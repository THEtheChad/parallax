{
  "schema": "parallax.profile/1",
  "name": "fake-check-fast",
  "lsp": { "command": ["node", "{bin}"] },
  "check": { "command": ["node", "{bin}", "-p", "{config}"] },
  "env": { "clear": ["FAKE_*"], "set": { "FAKE_CHECK_MS": "20", "FAKE_CHECK_OUTPUT": "src/a.ts(1,1): error TS1: x", "FAKE_CHECK_EXIT": "2" } },
  "crash": { "stderr": ["^panic: "] },
  "singleThreaded": { "check": { "env": { "FAKE_SINGLE_THREADED": "1" } }, "lsp": { "env": { "FAKE_SINGLE_THREADED": "1" } } }
}
