{
  "name": "parallax",
  "version": "0.0.0",
  "private": true,
  "description": "Parity, performance and gating harness for TypeScript compilers and language servers",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24.11"
  },
  "bin": {
    "parallax": "./src/cli.ts"
  },
  "scripts": {
    "parallax": "node src/cli.ts",
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json",
    "check": "pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
